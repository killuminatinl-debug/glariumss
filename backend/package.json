    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "date-fns": "4.1.0",
    "dayjs": "1.11.18",
    "dotenv": "16.4.5",
    "express": "5.2.0",
    "jsonwebtoken": "9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.2",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.5",
    "@types/node": "20.19.17",
    "nodemon": "3.1.10",
    "prisma": "6.16.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.2",
    "ts-node": "10.9.2"
  }
